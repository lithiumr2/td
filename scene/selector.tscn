[sub_resource type="GDScript" id="GDScript_b7g8k"]
script/source = "extends VBoxContainer

func _ready() -> void:
	for node in get_children():
		if node is BaseButton:
			node.z_index = 2
"

[sub_resource type="GDScript" id="GDScript_4nox3"]
script/source = "extends Button

func _pressed() -> void:
	Eb.init_round.emit()
"

